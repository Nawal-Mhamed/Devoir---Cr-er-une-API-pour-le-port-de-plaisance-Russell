{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["controllers", "services", "routes", "models"],
    "includePattern": ".js$",
    "excludePattern": "(node_modules/|docs/)"
  },
  "plugins": ["jsdoc-route-plugin"],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "opts": {
    "destination": "./public/docs",
    "recurse": true,
    "template": "node_modules/docdash"
  },
  "docdash": {
    "collapse": true,
    "search": true
  }
}
