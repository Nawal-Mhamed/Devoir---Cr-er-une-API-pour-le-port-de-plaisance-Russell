<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Catways</title>
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark w-100">
        <div class="container-fluid px-5">
          <a class="navbar-brand" href="#">Menu</a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a id="dashboard" class="nav-link" href="/dashboard"
                  >Tableau de bord</a
                >
              </li>
              <li class="nav-item">
                <a id="catways" class="nav-link" href="/catways"
                  >Gestionnaire de catways</a
                >
              </li>
              <li class="nav-item">
                <a
                  id="reservations"
                  class="nav-link active"
                  aria-current="page"
                  onclick="displayReservations('reservations', event)"
                  href="#"
                  >Gestionnaire de réservations</a
                >
              </li>
              <li class="nav-item">
                <a id="users" class="nav-link" href="/users"
                  >Gestionnaire des utilisateurs</a
                >
              </li>
              <li class="nav-item">
                <a
                  id="documentation"
                  class="nav-link"
                  href="#"
                  onclick="displayReservations('documentation', event)"
                  >Documentation</a
                >
              </li>
            </ul>
            <button id="deconnexion" class="btn btn-danger" type="submit">
              Se déconnecter
            </button>
          </div>
        </div>
      </nav>
    </header>

    <main class="p-5">
      <div id="reservations-section">
        <h1 class="text-center p-3">Gestionnaire des réservations</h1>

        <section>
          <h2 id="reservations-title" class="text-center p-3">
            Liste des réservations du catway <%= catwayNumber %>
          </h2>
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>Client</th>
                <th>Bateau</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Identifiant</th>
              </tr>
            </thead>

            <tbody>
              <% if (reservations.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center text-muted">
                  Aucune réservation
                </td>
              </tr>
              <% } else { %> <% reservations.forEach(function(reservation) { %>
              <tr>
                <td><%= reservation.clientName %></td>
                <td><%= reservation.boatName %></td>
                <td>
                  <%= new
                  Date(reservation.startDate).toLocaleDateString("fr-FR") %>
                </td>
                <td>
                  <%= new Date(reservation.endDate).toLocaleDateString("fr-FR")
                  %>
                </td>
                <td><%= reservation._id %></td>
              </tr>
              <% }) %> <% } %>
            </tbody>
          </table>
        </section>
      </div>

      <div id="documentation-section" style="display: none">
        <iframe
          src="/docs/index.html"
          style="width: 100%; height: 80vh; border: none"
        ></iframe>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/javascripts/reservations.js"></script>
  </body>
</html>
