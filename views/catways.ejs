<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/responsive.css" />
    <title>Port de Plaisance Russell - Catways</title>
  </head>

  <body data-role="<%= role %>">
    <!-- Navbar -->
    <header><%- include('partials/navbar', { activePage: 'catways'}) %></header>

    <!-- Main content -->
    <main class="p-md-5 mb-5">
      <section id="catways-section">
        <h1 class="text-center p-3">Gestionnaire des catways</h1>
        <h2 id="catways-title" class="text-center p-3">Liste des catways</h2>

        <!-- Search input + "Add" button -->
        <div
          class="mb-3 container-fluid d-flex flex-row justify-content-between col-md-9"
        >
          <div class="ms-2 col-8 col-md-6">
            <input
              type="number"
              id="catwaySearch"
              name="catwaySearch"
              placeholder="Recherche par numéro"
              class="form-control"
            />
          </div>
          <div class="col-auto">
            <button
              id="btnAddCatway"
              class="btn btn-success"
              data-bs-toggle="modal"
              data-bs-target="#catwayModal"
            >
              Ajouter
            </button>
          </div>
        </div>

        <!-- Catways table -->
        <article class="table-container col-12 col-md-9 p-3 mx-md-auto">
          <table
            class="table table-striped responsive-table table-hover align-middle table-bordered"
          >
            <thead>
              <tr>
                <th class="text-center">Numéro</th>
                <th class="text-center">Longueur</th>
                <th>État</th>
              </tr>
            </thead>

            <tbody class="table-group-divider">
              <% catways.forEach(function(catway) { %>
              <tr class="catway-row">
                <td class="catway-number" data-label="Numéro">
                  <%= catway.catwayNumber %>
                </td>
                <td class="catway-type" data-label="Longueur">
                  <%= catway.catwayType %>
                </td>
                <td data-label="État"><%= catway.catwayState %></td>
                <td class="text-center">
                  <button
                    class="btn btn-sm btn-secondary show show-catway"
                    data-id="<%= catway.catwayNumber %>"
                  >
                    Voir
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </article>
      </section>

      <!-- Documentation -->

      <%- include('partials/documentation') %>

      <!-- Modals -->
      <%- include('partials/modals/catwayModal') %>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/catway.js"></script>
  </body>
</html>
