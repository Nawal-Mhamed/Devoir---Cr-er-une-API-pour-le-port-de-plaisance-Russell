<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Catways</title>
  </head>

  <body data-role="<%= role %>">
    <!-- Navbar -->
    <header><%- include('partials/navbar', { activePage: 'catways'}) %></header>

    <!-- Main content -->
    <main class="p-5">
      <h1 class="text-center p-3">Gestionnaire des catways</h1>

      <section id="catways-section">
        <h2 id="catways-title" class="text-center p-3">Liste des catways</h2>

        <!-- Search input + "Add" button -->
        <div
          class="mb-3 container d-flex flex-row justify-content-between w-75"
        >
          <div class="container d-flex flex-row">
            <input
              type="number"
              id="catwaySearch"
              name="catwaySearch"
              placeholder="Entrez le numéro du catway"
              class="form-control w-50"
            />
          </div>
          <button
            id="btnAddCatway"
            class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#catwayModal"
          >
            Ajouter
          </button>
        </div>

        <!-- Catways table -->
        <article class="table-container w-75 mx-auto">
          <table
            class="table table-striped table-hover align-middle table-bordered"
          >
            <thead>
              <tr>
                <th class="text-center">Numéro</th>
                <th class="text-center">Longueur</th>
                <th>État</th>
              </tr>
            </thead>

            <tbody class="table-group-divider">
              <% catways.forEach(function(catway) { %>
              <tr class="catway-row">
                <td class="text-center catway-number">
                  <%= catway.catwayNumber %>
                </td>
                <td class="text-center"><%= catway.catwayType %></td>
                <td><%= catway.catwayState %></td>
                <td class="text-center">
                  <button
                    class="btn btn-sm btn-secondary show show-catway"
                    data-id="<%= catway.catwayNumber %>"
                  >
                    Voir
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </article>
      </section>

      <!-- Documentation -->

      <%- include('partials/documentation') %>

      <!-- Modals -->
      <%- include('partials/modals/catwayModal') %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/catway.js"></script>
  </body>
</html>
