<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Réservations</title>
  </head>

  <body data-role="<%= role %>" class="d-flex flex-column min-vh-100">
    <!-- Navbar -->
    <header>
      <%- include('partials/navbar', { activePage: 'reservations'}) %>
    </header>

    <!-- Reservation data -->
    <main class="p-md-5 mb-5 flex-fill">
      <section id="reservations-section" class="container-fluid">
        <h1 class="text-center p-3">
          Informations sur la réservation - Catway n° <%= reservation ?
          reservation.catwayNumber : catwayNumber %>
        </h1>

        <article id="reservationDetails" class="row mx-auto mt-3">
          <% if (reservation) { %>

          <!-- Display card -->
          <div class="card shadow-sm col-12 col-md-9 p-4 mt-3 mx-auto">
            <h2 class="mb-3 text-center">
              Réservation n°<%= reservation._id %>
            </h2>
            <p>
              <strong>Numéro du catway :</strong>
              <span class="reservation-catway"
                ><%= reservation.catwayNumber %></span
              >
            </p>
            <p>
              <strong>Client :</strong>
              <span class="reservation-client"
                ><%= reservation.clientName %></span
              >
            </p>
            <p>
              <strong>Bateau :</strong>
              <span class="reservation-boat"><%= reservation.boatName %></span>
            </p>
            <p>
              <strong>Date de début :</strong>
              <span class="reservation-startDate"
                ><%= new Date(reservation.startDate).toLocaleDateString("fr-FR")
                %></span
              >
            </p>
            <p>
              <strong>Date de fin :</strong>
              <span class="reservation-endDate"
                ><%= new Date(reservation.endDate).toLocaleDateString("fr-FR")
                %></span
              >
            </p>

            <!-- "Update", "Delete" and "Back" buttons -->
            <div
              class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-3 align-items-center"
            >
              <button
                class="btn btn-primary edit edit-reservation"
                data-id="<%= reservation._id %>"
                data-catway="<%= reservation.catwayNumber %>"
                data-client="<%= reservation.clientName %>"
                data-boat="<%= reservation.boatName %>"
                data-startdate="<%= new Date(reservation.startDate).toISOString().split('T')[0] %>"
                data-enddate="<%= new Date(reservation.endDate).toISOString().split('T')[0] %>"
              >
                Modifier
              </button>
              <button
                class="btn btn-danger delete delete-reservation"
                data-id="<%= reservation.catwayNumber %>"
                data-sub-id="<%= reservation._id %>"
                data-entity-type="reservation"
              >
                Supprimer
              </button>
              <button
                class="btn btn-secondary"
                id="backToList"
                data-catway="<%= reservation.catwayNumber %>"
              >
                Retour
              </button>
            </div>
          </div>

          <!-- "Show All" button -->
          <div class="mx-auto mt-3 text-center w-100">
            <button id="btnShowAll" class="btn btn-outline-secondary me-3">
              Tout afficher
            </button>
          </div>

          <% } else if (errorMessage) { %>
          <!-- Display error message -->
          <p class="text-center h4 p-4"><strong><%= errorMessage %></strong></p>
          <div class="d-flex justify-content-center gap-3 mt-3">
            <button class="btn btn-secondary" id="backToList" data-catway="0">
              Retour
            </button>
          </div>
          <% } %>
        </article>
      </section>

      <!-- Documentation -->
      <%- include('partials/documentation') %>

      <!-- Modals -->
      <%- include('partials/modals/reservationModal') %> <%-
      include('partials/modals/confirmDelete') %>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/reservations.js"></script>
  </body>
</html>
