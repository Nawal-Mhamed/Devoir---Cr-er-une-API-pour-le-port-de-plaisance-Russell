<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Catways</title>
  </head>

  <body>
    <!-- Menu de navigation -->

    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark w-100">
        <div class="container-fluid px-5">
          <a class="navbar-brand" href="#">Menu</a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a id="dashboard" class="nav-link" href="/dashboard"
                  >Tableau de bord</a
                >
              </li>
              <li class="nav-item">
                <a
                  id="catways"
                  class="nav-link active"
                  aria-current="page"
                  href="#"
                  onclick="displayCatways('catways', event)"
                  >Catways</a
                >
              </li>
              <li class="nav-item">
                <a
                  id="reservations"
                  class="nav-link"
                  href="/catways/0/reservations"
                  >Réservations</a
                >
              </li>
              <li class="nav-item">
                <a id="users" class="nav-link" href="/users">Utilisateurs</a>
              </li>
              <li class="nav-item">
                <a
                  id="documentation"
                  class="nav-link"
                  href="#"
                  onclick="displayCatways('documentation', event)"
                  >Documentation</a
                >
              </li>
            </ul>
            <button id="deconnexion" class="btn btn-danger" type="submit">
              Se déconnecter
            </button>
          </div>
        </div>
      </nav>
    </header>

    <main class="p-5">
      <div id="catways-section">
        <h1 class="text-center p-3">Gestionnaire des catways</h1>

        <section>

          <div
            class="mb-3 container d-flex flex-row w-75"
          >
            <input
              type="number"
              id="catwaySearch"
              name="catwaySearch"
              placeholder="Rechercher un catway"
              class="form-control w-50"
            />
            <button id="btnSearchCatway" class="btn btn-primary ms-2">
              Rechercher
            </button>
          </div>


          <!-- Section pour afficher le catway recherché -->
          <h2 class="text-center p-3">Informations sur le catway</h2>

          <div id="catwayDetails" class="w-75 mx-auto mt-4">
            <% if (catway) { %>
              <!-- Affichage de la card -->
              <div class="card shadow-sm p-4 mt-3 mx-auto">
                <h3 class="mb-3 text-center">Catway n°<%= catway.catwayNumber %></h3>
                <p><strong>Longueur :</strong> <span class="catway-type"><%= catway.catwayType %></span></p>
                <p><strong>État :</strong> <span class="catway-state"><%= catway.catwayState %></span></p>
                <div class="d-flex justify-content-center gap-3 mt-3">
                  <button class="btn btn-primary edit edit-catway" data-id="<%= catway.catwayNumber %>" data-type="<%= catway.catwayType %>" data-state="<%= catway.catwayState %>">Modifier</button>
                  <button class="btn btn-danger delete delete-catway" data-id="<%= catway.catwayNumber %>">Supprimer</button>
                  <button class="btn btn-secondary" id="backToList">Retour</button>
                </div>
              </div>
          <% } else if (errorMessage) { %>
            <!-- Affichage du message d'erreur -->
            <p class="text-center h4 p-4"><strong><%= errorMessage %></strong></p>
            <div class="d-flex justify-content-center gap-3 mt-3">
              <button class="btn btn-secondary" id="backToList">Retour</button>
            </div>
          <% } %>
        </div>

      <!-- iframe pour la documentation JSDoc -->

      <div id="documentation-section" style="display: none">
        <iframe
          src="/docs/index.html"
          style="width: 100%; height: 80vh; border: none"
        ></iframe>
      </div>

      <!-- Modales -->

      <div class="modal fade" id="catwayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <form id="catwayForm" class="modal-content">
            <div class="modal-header">
              <h3 class="modal-title" id="catwayModalTitle">
                Modifier un catway
              </h3>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Fermer"
              ></button>
            </div>

            <div class="modal-body">
              <input type="hidden" id="catwayId" name="id" />

              <div class="mb-3">
                <label for="catwayNumber" class="form-label">Numéro</label>
                <input
                  id="catwayNumber"
                  name="catwayNumber"
                  type="number"
                  class="form-control"
                  required
                />
              </div>

              <div class="mb-3">
                <label for="catwayType" class="form-label">Longueur</label>
                <select
                  id="catwayType"
                  name="catwayType"
                  class="form-control"
                  required
                >
                  <option value="long">long</option>
                  <option value="short">short</option>
                </select>
              </div>

              <div class="mb-3">
                <label for="catwayState" class="form-label">État</label>
                <textarea
                  id="catwayState"
                  name="catwayState"
                  type="text"
                  class="form-control"
                  required
                ></textarea>
              </div>

              <div id="catwayError" class="alert alert-danger d-none"></div>
            </div>

            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
              >
                Annuler
              </button>
              <button type="submit" id="catwaySubmit" class="btn btn-primary">
                Enregistrer
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Modale de confirmation suppression -->
      <div
        class="modal fade"
        id="confirmDeleteModal"
        tabindex="-1"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-sm">
          <div class="modal-content">
            <div class="modal-body text-center p-4">
              <p>Voulez-vous supprimer ce catway ?</p>
              <div class="d-flex justify-content-center gap-2">
                <button
                  type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal"
                >
                  Annuler
                </button>
                <button
                  id="confirmDeleteBtn"
                  type="button"
                  class="btn btn-danger"
                >
                  Supprimer
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/catway.js"></script>
  </body>
</html>
