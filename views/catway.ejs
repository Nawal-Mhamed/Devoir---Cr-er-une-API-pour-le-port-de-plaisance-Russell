<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Catways</title>
  </head>

  <body data-role="<%= role %>">
    <!-- Navbar -->
    <header><%- include('partials/navbar', { activePage: 'catways'}) %></header>

    <!-- Catway data -->
    <main class="p-5">
      <section id="catways-section">
        <h1 class="text-center p-3">Informations sur le catway</h1>

        <article id="catwayDetails" class="w-75 mx-auto mt-4">
          <% if (catway) { %>

          <!-- Display card-->
          <div class="card shadow-sm p-4 mt-3 mx-auto">
            <h2 class="mb-3 text-center">
              Catway n°<%= catway.catwayNumber %>
            </h2>
            <p>
              <strong>Longueur :</strong>
              <span class="catway-type"><%= catway.catwayType %></span>
            </p>
            <p>
              <strong>État :</strong>
              <span class="catway-state"><%= catway.catwayState %></span>
            </p>
            <div class="d-flex justify-content-center gap-3 mt-3">
              <button
                class="btn btn-primary edit edit-catway"
                data-id="<%= catway.catwayNumber %>"
                data-type="<%= catway.catwayType %>"
                data-state="<%= catway.catwayState %>"
              >
                Modifier
              </button>
              <button
                class="btn btn-danger delete delete-catway"
                data-id="<%= catway.catwayNumber %>"
                data-entity-type="catway"
              >
                Supprimer
              </button>
              <button class="btn btn-secondary" id="backToList">Retour</button>
            </div>
          </div>

          <% } else if (errorMessage) { %>

          <!-- Display error message -->
          <p class="text-center h4 p-4"><strong><%= errorMessage %></strong></p>
          <div class="d-flex justify-content-center gap-3 mt-3">
            <button class="btn btn-secondary" id="backToList">Retour</button>
          </div>
          <% } %>
        </article>
      </section>

      <!-- Documentation -->

      <%- include('partials/documentation') %>

      <!-- Modals -->

      <%- include('partials/modals/catwayModal') %> <%-
      include('partials/modals/confirmDelete') %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/catway.js"></script>
  </body>
</html>
