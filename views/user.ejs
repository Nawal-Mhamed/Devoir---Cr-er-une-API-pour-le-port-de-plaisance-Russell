<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Utilisateurs</title>
  </head>

  <body data-role="<%= role %>" data-email="<%= user ? user.email : '' %>">
    <!-- Navbar -->
    <header><%- include('partials/navbar', { activePage: 'users'}) %></header>

    <!-- User data -->
    <main class="p-5">
      <section id="users-section">
        <h1 class="text-center p-3">Informations sur l'utilisateur</h1>

        <article id="userDetails" class="w-75 mx-auto mt-4">
          <% if (user) { %>

          <!-- Display card -->
          <div class="card shadow-sm p-4 mt-3 mx-auto">
            <h2 class="mb-3 text-center"><%= user.username %></h2>
            <p>
              <strong>Email :</strong>
              <span class="user-email"><%= user.email %></span>
            </p>
            <p>
              <strong>Membre depuis le :</strong> <%= new
              Date(user.createdAt).toLocaleDateString("fr-FR", { weekday:
              "long", year: "numeric", month: "long", day: "numeric" }) %>
            </p>
            <p>
              <strong>Rôle :</strong>
              <span class="user-role"><%= user.role %></span>
            </p>
            <div class="d-flex justify-content-center gap-3 mt-3">
              <button
                class="btn btn-primary edit edit-user"
                data-username="<%= user.username %>"
                data-email="<%= user.email %>"
                data-role="<%= user.role %>"
              >
                Modifier
              </button>
              <% if (role === 'administrateur' && !isOwnProfile) { %>
              <button
                class="btn btn-danger delete delete-user"
                data-email="<%= user.email %>"
                data-entity-type="user"
              >
                Supprimer
              </button>
              <% } %>
              <button class="btn btn-secondary" id="backToList">Retour</button>
            </div>
          </div>

          <% } else if (errorMessage) { %>

          <!-- Display error message -->
          <p class="text-center h4 p-4"><strong><%= errorMessage %></strong></p>
          <div class="d-flex justify-content-center gap-3 mt-3">
            <button class="btn btn-secondary" id="backToList">Retour</button>
          </div>
          <% } %>
        </article>
      </section>

      <!-- Documentation -->
      <%- include('partials/documentation') %>

      <!-- Modals -->
      <%- include('partials/modals/userModal') %> <%-
      include('partials/modals/confirmDelete') %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/user.js"></script>
  </body>
</html>
