<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/responsive.css" />
    <title>Port de plaisance Russell</title>
  </head>

  <body>
    <!-- Navbar-->

    <header>
      <nav class="navbar navbar-expand navbar-dark bg-dark w-100">
        <div class="container-fluid w-100 w-md-50">
          <ul class="navbar-nav container d-flex justify-content-around">
            <li class="nav-item">
              <a
                id="home"
                class="nav-link active"
                aria-current="page"
                href="#"
                onclick="displaySection('accueil', event)"
                >Accueil</a
              >
            </li>
            <li class="nav-item">
              <a
                id="connexion"
                class="nav-link"
                href="#"
                onclick="displaySection('connexion', event)"
                >Se connecter</a
              >
            </li>
            <li class="nav-item">
              <a
                id="documentation"
                class="nav-link"
                href="#"
                onclick="displaySection('documentation', event)"
                >Documentation</a
              >
            </li>
          </ul>
        </div>
      </nav>
    </header>

    <!-- Home page content -->
    <main id="content" class="w-100 mb-5 px-md-5">
      <!-- Presentation -->
      <section
        class="card my-5 p-5 mx-auto mw-100 shadow p-3 mb-5 bg-body-tertiary rounded"
        id="cardSection"
      >
        <div class="card-body">
          <h1 class="card-title text-center my-5">Port de Plaisance Russel</h1>

          <article>
            <h2 class="card-subtitle mb-2 text-body-secondary text-center mb-5">
              Bienvenue au Port de Plaisance Russel !
            </h2>
            <p class="card-text">
              Ce site a été conçu afin de faciliter la gestion des réservations
              de catway du Port de Plaisance Russell.
            </p>
            <p class="card-text">
              Pour pouvoir l'utiliser, vous devez commencer par vous
              <a
                href="#"
                onclick="displaySection('connexion', event)"
                class="card-link"
                >connecter</a
              >
              à la base de données.
            </p>
          </article>
        </div>
      </section>
    </main>

    <!-- Alert message when logging out -->

    <% if (logoutStatus === 'success') { %>
    <div
      id="logoutAlert"
      class="alert alert-success text-center position-fixed top-0 start-50 translate-middle-x mt-3"
      style="z-index: 9999"
    >
      ✅ Vous avez été déconnecté.
    </div>
    <% } else if (logoutStatus === 'expired') { %>
    <div class="alert alert-warning text-center">
      Votre session a expiré. Veuillez vous reconnectez.
    </div>
    <% } %>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/javascripts/index.js"></script>
    <script src="/javascripts/common.js"></script>
  </body>
</html>
