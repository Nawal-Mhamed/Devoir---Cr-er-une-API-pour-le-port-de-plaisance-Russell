<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Tableau de bord</title>
  </head>
  <body data-role="<%= user.role %>">
    <!-- Navbar -->
    <header>
      <%- include('partials/navbar', { activePage: 'dashboard'}) %>
    </header>

    <!-- Dashboard content -->
    <main id="content" class="p-5">
      <h1 class="text-center mb-5">Tableau de bord</h1>

      <!-- Connected user data -->

      <section id="dashboard-section">
        <article class="card p-4 mb-4 mx-auto">
          <div class="d-flex flex-row align-items-center">
            <img
              src="https://www.shutterstock.com/image-vector/vector-flat-illustration-grayscale-avatar-600nw-2264922221.jpg"
              alt="Profil"
              class="rounded-circle me-4 img-fluid"
            />

            <div class="card-body">
              <h2 class="card-title">Bonjour <%= user.username %> !</h2>
              <p class="card-text">Nom d'utilisateur : <%= user.username %></p>
              <p class="card-text">Email : <%= user.email %></p>
              <p class="card-text">Role : <%= user.role %></p>
              <a id="deconnexion" class="btn btn-danger" href="/logout"
                >Se déconnecter</a
              >
            </div>
          </div>
          <p class="ms-auto text-end text-muted small"><%= today %></p>
        </article>

        <!-- Current reservations table -->

        <article class="mb-3">
          <h2 class="text-center mt-5">Réservations en cours</h2>

          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>Catway</th>
                <th>Client</th>
                <th>Bateau</th>
                <th>Début</th>
                <th>Fin</th>
              </tr>
            </thead>

            <tbody>
              <% if (activeReservations.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center text-muted">
                  Aucune réservation en cours
                </td>
              </tr>
              <% } else { %> <% activeReservations.forEach(reservation => { %>
              <tr>
                <td><%= reservation.catwayNumber %></td>
                <td><%= reservation.clientName %></td>
                <td><%= reservation.boatName %></td>
                <td>
                  <%= reservation.startDate.toLocaleDateString("fr-FR") %>
                </td>
                <td><%= reservation.endDate.toLocaleDateString("fr-FR") %></td>
              </tr>
              <% }) %> <% } %>
            </tbody>
          </table>
        </article>
      </section>

      <!-- Documentation -->
      <%- include('partials/documentation') %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script type="module" src="/javascripts/main.js"></script>
  </body>
</html>
