<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Tableau de bord</title>
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark w-100">
        <div class="container-fluid px-5">
          <a class="navbar-brand" href="#">Menu</a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a
                id="dashboard"
                  class="nav-link active"
                  aria-current="page"
                  href="#"
                  onclick="displayDashboard('dashboard', event)"
                  >Tableau de bord</a
                >
              </li>
              <li class="nav-item">
                <a id="catways" class="nav-link" href="/catways"
                  >Gestionnaire de catways</a
                >
              </li>
              <li class="nav-item">
                <a
                  id="reservations"
                  class="nav-link"
                  href="#"
                  >Gestionnaire de réservations</a
                >
              </li>
              <li class="nav-item">
                <a id="users" class="nav-link" href="/users"
                  >Gestionnaire des utilisateurs</a
                >
              </li>
              <li class="nav-item">
                <a
                  id="documentation"
                  class="nav-link"
                  href="#"
                  onclick="displayDashboard('documentation', event)"
                  >Documentation</a
                >
              </li>
            </ul>
            <button id="deconnexion" class="btn btn-danger" type="submit">Se déconnecter</button>
          </div>
        </div>
      </nav>
    </header>

    <main id="content" class="p-5">
      <div id="dashboard-section">
      <h1 class="text-center mb-5">Tableau de bord</h1>

      <!-- Informations sur l'utilisateur connecté -->

      <section class="card p-4 mb-4 mx-auto">
        <div class="d-flex flex-row align-items-center">
        <img src="https://www.shutterstock.com/image-vector/vector-flat-illustration-grayscale-avatar-600nw-2264922221.jpg" alt="Profil" class="rounded-circle me-4 img-fluid" />

        <article class="card-body">
          <h2 class="card-title">Bonjour <%= user.username %> !</h3>
          <p class="card-text">Nom d'utilisateur : <%= user.username %></p>
          <p class="card-text">Email: <%= user.email %></p>
          <a id="deconnexion" class="btn btn-danger" href="/logout"
            >Se déconnecter</a
          >
        </article>
      </div>
        <p class="ms-auto text-end text-muted small"><%= today %></p>
      </section>

      <!-- Tableau des réservations -->

      <section class="mb-3">
        <h3>Réservations en cours</h3>

        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>Catway</th>
              <th>Client</th>
              <th>Bateau</th>
              <th>Début</th>
              <th>Fin</th>
            </tr>
          </thead>

          <tbody>
            <% if (activeReservations.length === 0) { %> 
              <tr>
                <td colspan="5" class="text-center text-muted">
                  Aucune réservation en cours
                </td>
              </tr>
            <% } else { %>
              <% activeReservations.forEach(reservation => { %>
                <tr>
                  <td><%= reservation.catwayNumber %></td>
                  <td><%= reservation.clientName %></td>
                  <td><%= reservation.boatName %></td>
                  <td><%= reservation.startDate.toLocaleDateString("fr-FR") %></td>
                  <td><%= reservation.endDate.toLocaleDateString("fr-FR") %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </section>
      </div>

      <div id="documentation-section" style="display: none;">
        <iframe
          src="/docs/index.html"
          style="width: 100%; height: 80vh; border: none"
        ></iframe>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/javascripts/dashboard.js"></script>
  </body>
</html>
