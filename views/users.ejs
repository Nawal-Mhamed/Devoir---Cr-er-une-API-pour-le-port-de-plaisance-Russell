<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Port de Plaisance Russell - Utilisateurs</title>
  </head>

  <body data-role="<%= role %>">
    <!-- Navbar -->
    <header><%- include('partials/navbar', { activePage: 'users'}) %></header>

    <!-- Main content -->
    <main class="p-5">
      <h1 class="text-center p-3">Gestionnaire des utilisateurs</h1>
      <section id="users-section">
        <h2 id="users-title" class="text-center p-3">Liste des utilisateurs</h2>

        <!-- Search input + "Add" button -->
        <div
          class="mb-3 container d-flex flex-row justify-content-between w-75"
        >
          <div class="container d-flex flex-row">
            <input
              type="email"
              id="userSearch"
              name="userSearch"
              placeholder="Entrez l'email de l'utilisateur"
              class="form-control w-50"
            />
          </div>
          <button
            id="btnAddUser"
            class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#userModal"
          >
            Ajouter
          </button>
        </div>

        <!-- Users table -->
        <article class="table-container">
          <table
            class="table table-striped table-hover w-75 mx-auto align-middle table-bordered"
          >
            <thead>
              <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Membre depuis le</th>
                <th>Rôle</th>
              </tr>
            </thead>

            <tbody class="table-group-divider">
              <% users.forEach(function(user) { %>
              <tr class="user-row">
                <td><%= user.username %></td>
                <td class="user-email"><%= user.email %></td>
                <td>
                  <%= new Date(user.createdAt).toLocaleDateString("fr-FR", {
                  weekday: "long", year: "numeric", month: "long", day:
                  "numeric" }) %>
                </td>
                <td><%= user.role %></td>
                <td class="text-center">
                  <button
                    class="btn btn-sm btn-secondary show show-user"
                    data-email="<%= user.email %>"
                  >
                    Voir
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </article>
      </section>

      <!-- Documentation -->
      <%- include('partials/documentation') %>

      <!-- Modals -->
      <%- include('partials/modals/userModal') %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/user.js"></script>
  </body>
</html>
