<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/responsive.css" />
    <title>Port de Plaisance Russell - Utilisateurs</title>
  </head>

  <body data-role="<%= role %>">
    <!-- Navbar -->
    <header><%- include('partials/navbar', { activePage: 'users'}) %></header>

    <!-- Main content -->
    <main class="mb-5 p-md-5">
      <section id="users-section" class="container-fluid">
        <h1 class="text-center p-3">Gestionnaire des utilisateurs</h1>
        <h2 id="users-title" class="text-center p-3">Liste des utilisateurs</h2>

        <!-- Search input + "Add" button -->
        <div
          class="mb-3 container-fluid d-flex flex-row justify-content-between col-md-9"
        >
          <div class="ms-2 col-8 col-md-6">
            <input
              type="email"
              id="userSearch"
              name="userSearch"
              placeholder="Recherche par email"
              class="form-control"
            />
          </div>
          <div class="col-auto">
            <button
              id="btnAddUser"
              class="btn btn-success"
              data-bs-toggle="modal"
              data-bs-target="#userModal"
            >
              Ajouter
            </button>
          </div>
        </div>

        <!-- Users table -->
        <article class="table-container col-12 col-md-9 p-3 mx-md-auto">
          <table
            class="table table-striped responsive-table table-hover align-middle table-bordered"
          >
            <thead>
              <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Membre depuis le</th>
                <th>Rôle</th>
              </tr>
            </thead>

            <tbody class="table-group-divider">
              <% users.forEach(function(user) { %>
              <tr class="user-row">
                <td data-label="Nom"><%= user.username %></td>
                <td class="user-email" data-label="Email"><%= user.email %></td>
                <td data-label="Membre depuis le">
                  <%= new Date(user.createdAt).toLocaleDateString("fr-FR", {
                  weekday: "long", year: "numeric", month: "long", day:
                  "numeric" }) %>
                </td>
                <td data-label="Rôle"><%= user.role %></td>
                <td class="text-center">
                  <button
                    class="btn btn-sm btn-secondary show show-user"
                    data-email="<%= user.email %>"
                  >
                    Voir
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </article>
      </section>

      <!-- Documentation -->
      <%- include('partials/documentation') %>

      <!-- Modals -->
      <%- include('partials/modals/userModal') %>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script type="module" src="/javascripts/main.js"></script>
    <script type="module" src="/javascripts/user.js"></script>
  </body>
</html>
